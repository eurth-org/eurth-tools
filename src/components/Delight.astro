---
// The hub's two small pleasures, on every page: today's door swings open once a visit, and
// typing "yurt" pitches a little yurt. Both are decided in src/hub/delight.ts.
---

<script>
  import '../scripts/delight.ts';
</script>

<style is:global>
  /* The easter egg: a little yurt in the corner, with sparkles. Decorative, and gone again in a
     few seconds; for reduced motion it stands still. */
  .egg-yurt {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 50;
    width: var(--space-16);
    height: var(--space-16);
    pointer-events: none;
    animation: egg-pitch 0.45s ease-out;
  }

  .egg-yurt img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .egg-yurt i {
    position: absolute;
    width: var(--space-3);
    height: var(--space-3);
    background: var(--highlight);
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
    animation: egg-sparkle 0.9s ease-in-out 3 both;
  }

  .egg-yurt i:nth-child(2) {
    top: calc(var(--space-3) * -1);
    left: calc(var(--space-2) * -1);
  }

  .egg-yurt i:nth-child(3) {
    top: calc(var(--space-4) * -1);
    right: var(--space-2);
    animation-delay: 0.2s;
  }

  .egg-yurt i:nth-child(4) {
    top: var(--space-4);
    right: calc(var(--space-4) * -1);
    animation-delay: 0.4s;
  }

  .egg-yurt i:nth-child(5) {
    bottom: var(--space-1);
    left: calc(var(--space-4) * -1);
    animation-delay: 0.6s;
  }

  @keyframes egg-pitch {
    from {
      transform: translateY(100%) scale(0.6);
    }
    to {
      transform: none;
    }
  }

  @keyframes egg-sparkle {
    0%,
    100% {
      transform: scale(0.2);
      opacity: 0;
    }
    50% {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
